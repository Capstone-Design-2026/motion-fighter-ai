  location: "포로 수용소"
  background: {fileID: 0}
  lines:
  - speaker: "의원"
    text: "도윤 어른이 간수들의 관심을 끌어 주어 다친 사람들을 돌볼 수 있었소."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "주인공"
    text: "지금 어디 계십니까?"
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "의원"
    text: "채석장에서 온 특별 호송대가 데려갔소. 가까운 약품 보관소에 치료할 약이 남아 있소."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
