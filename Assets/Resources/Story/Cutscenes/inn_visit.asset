  m_Script: {fileID: 11500000, guid: 85d62e4334b344bbb5f101eb276dd205, type: 3}
  m_Name: inn_visit
  m_EditorClassIdentifier: 
  location: "청계역"
  background: {fileID: 0}
  lines:
  - speaker: "연화"
    text: "도윤 어른이 붙잡혔구나. 그날 지나간 행렬이 셋이었어."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "연화"
    text: "계곡으로는 무거운 수레가 갔어. 안에서 기침 소리가 났지. 능선에는 말을 탄 무인들이, 서쪽 다리에는 짐꾼들이 갔고."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "주인공"
    text: "서로 다른 행렬이군요. 흔적을 직접 확인하겠습니다."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
