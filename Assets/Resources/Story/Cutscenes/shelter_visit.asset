  location: "수문 앞 대피처"
  background: {fileID: 0}
  lines:
  - speaker: "도윤"
    text: "어깨에 힘이 빠졌구나."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "주인공"
    text: "이제는 언제 들어가야 할지 조금 보입니다."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "도윤"
    text: "그렇다면 네 판단을 믿어라. 사람들은 내가 맡으마."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
