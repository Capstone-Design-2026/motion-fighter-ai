  location: "수문 앞 대피처"
  background: {fileID: 0}
  backgroundTexture: {fileID: 2800000, guid: 3bef652f35f44da6aa9330e3a4373ba7, type: 3}
  backgroundUv: {serializedVersion: 2, x: 0.5, y: 0.5690625, width: 0.5, height: 0.421875}
  lines:
  - speaker: "도윤"
    text: "어깨에 힘이 빠졌구나."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 1
    leftActor: {fileID: 11400000, guid: 785c8ad844794d05b385c0ee103179fe, type: 2}
    rightActor: {fileID: 11400000, guid: 55858f90022548a98e0a6ac5c29d15f9, type: 2}
  - speaker: "서진"
    text: "이제는 언제 들어가야 할지 조금 보입니다."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
    leftActor: {fileID: 11400000, guid: 785c8ad844794d05b385c0ee103179fe, type: 2}
    rightActor: {fileID: 11400000, guid: 55858f90022548a98e0a6ac5c29d15f9, type: 2}
  - speaker: "도윤"
    text: "그렇다면 네 판단을 믿어라. 사람들은 내가 맡으마."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 1
    leftActor: {fileID: 11400000, guid: 785c8ad844794d05b385c0ee103179fe, type: 2}
    rightActor: {fileID: 11400000, guid: 55858f90022548a98e0a6ac5c29d15f9, type: 2}
