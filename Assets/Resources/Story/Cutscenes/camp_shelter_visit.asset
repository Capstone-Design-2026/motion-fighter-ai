  location: "버려진 수색 움막"
  background: {fileID: 0}
  backgroundTexture: {fileID: 2800000, guid: 3bef652f35f44da6aa9330e3a4373ba7, type: 3}
  backgroundUv: {serializedVersion: 2, x: 0.5, y: 0, width: 0.5, height: 0.421875}
  lines:
  - speaker: "벽에 남은 글씨"
    text: "셋 모두 내려감."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
    leftActor: {fileID: 11400000, guid: 785c8ad844794d05b385c0ee103179fe, type: 2}
    rightActor: {fileID: 0}
    evidence: 2
    evidenceTitle: "남겨진 짧은 기록"
  - speaker: "서진"
    text: "사부님이 벌어 주신 시간 덕분에 살아 돌아간 사람들이 있어."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
    leftActor: {fileID: 11400000, guid: 785c8ad844794d05b385c0ee103179fe, type: 2}
    rightActor: {fileID: 0}
  - speaker: "서진"
    text: "앞은 낙석으로 막혔다. 쉬었다가 약초꾼의 쉼터로 돌아가자."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
    leftActor: {fileID: 11400000, guid: 785c8ad844794d05b385c0ee103179fe, type: 2}
    rightActor: {fileID: 0}
