  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 85d62e4334b344bbb5f101eb276dd205, type: 3}
  m_Name: final_after
  m_EditorClassIdentifier: 
  location: "수문 요새"
  background: {fileID: 0}
  lines:
  - speaker: ""
    text: "무진이 쓰러지고 수문 장치가 멈춘다. 계곡을 울리던 경종도 잦아든다."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "주인공"
    text: "이제 돌아갈 수 있어."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "도윤"
    text: "이 길들을 모두 네가 찾았느냐?"
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "주인공"
    text: "몇 번은 잘못 갔습니다."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "도윤"
    text: "그래도 돌아왔구나."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "주인공"
    text: "이제 돌아가는 길은 압니다."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: ""
    text: "무진은 생포되고 잔당은 흩어졌다. 수문은 마을 사람들에게 인계되었다. 사부와 제자는 함께 도장으로 돌아간다."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
