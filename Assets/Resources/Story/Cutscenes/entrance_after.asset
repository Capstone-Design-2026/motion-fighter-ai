  location: "흑운협 입구"
  background: {fileID: 0}
  lines:
  - speaker: "주인공"
    text: "늦었습니다."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "도윤"
    text: "아니다. 여기까지 네 힘으로 왔구나."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: ""
    text: "요새에서 경종이 울린다. 무진이 수문을 열 준비를 시작했다."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "주인공"
    text: "사람들을 데리고 내려가세요. 돌아갈 길은 제가 지키겠습니다."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
