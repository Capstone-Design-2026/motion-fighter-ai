    evidence: 2
    evidenceTitle: "남겨진 밀서"
    voice: {fileID: 0}
    voiceEnvelope: []
    videoSpeechTrack: {fileID: 0}
  - speaker: "찢어진 밀서"
    text: "흑운협 재가동 전까지 외부인의 접근을 차단할 것."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
    leftActor: {fileID: 11400000, guid: 785c8ad844794d05b385c0ee103179fe, type: 2}
    rightActor: {fileID: 0}
    evidence: 2
    evidenceTitle: "흑운협 재가동 명령"
    voice: {fileID: 0}
    voiceEnvelope: []
    videoSpeechTrack: {fileID: 0}
  - speaker: "청운"
    text: "나머지 기록은 위쪽 정자로 옮겨졌군."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
