  location: "버려진 전망대"
  background: {fileID: 0}
  lines:
  - speaker: "주인공"
    text: "최근 봉화를 올린 흔적이다. 통신문도 남아 있어."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "찢어진 통신문"
    text: "흑운협 재가동 전까지 외부인의 접근을 차단할 것."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
  - speaker: "주인공"
    text: "나머지 기록은 위쪽 정자로 옮겨졌군."
    leftPortrait: {fileID: 0}
    rightPortrait: {fileID: 0}
    speakerOnRight: 0
